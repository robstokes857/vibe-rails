<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <AssemblyName>vb</AssemblyName>
    <RootNamespace>VibeRails</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <Version>1.7.7</Version>
    <FileVersion>1.7.7.0</FileVersion>
    <InformationalVersion>1.7.7</InformationalVersion>
    <NoWarn>$(NoWarn);IL2104;IL2026;IL2057;IL2070;IL2075;IL2080;IL3050</NoWarn>
    <!-- sqlite-vec native binaries exist for all our target RIDs (including arm64) but its
         .targets file only allows x64/x86 PlatformTarget. Disable the check. -->
    <EnableUnsupportedPlatformTargetCheck>false</EnableUnsupportedPlatformTargetCheck>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.*" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.26.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pty.Net\Pty.Net.csproj" />
    <ProjectReference Include="..\TerminalEmulator\TerminalEmulator.csproj" />
  </ItemGroup>
  <!-- Copy wwwroot to output directory -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot\assets\" />
  </ItemGroup>
  <!-- Copy bundled BERT model assets to output directory -->
  <ItemGroup>
    <Content Include="Models\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
      <Link>Models\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <!-- Copy public cert to output directory -->
  <ItemGroup>
    <Content Include="Certs\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
      <Link>Certs\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <!-- Copy root download scripts to output directory for post-deploy setup -->
  <ItemGroup>
    <Content Include="..\Scripts\download-bert-model.ps1" Link="Scripts\download-bert-model.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Scripts\download-bert-model.sh" Link="Scripts\download-bert-model.sh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Copy hook scripts to output directory -->
  <!-- Create the scripts subdirectory explicitly to avoid a race condition under NativeAOT
       publish where the RID-specific bin layout doesn't pre-create content subdirectories. -->
  <Target Name="EnsureScriptsDirExists" BeforeTargets="CopyFilesToOutputDirectory;_CopyOutOfDateSourceItemsToOutputDirectory">
    <MakeDir Directories="$(OutDir)scripts" />
  </Target>
  <Target Name="EnsureScriptsDirExistsForPublish" BeforeTargets="CopyFilesToPublishDirectory;_CopyResolvedFilesToPublishAlways;_CopyResolvedFilesToPublishPreserveNewest">
    <MakeDir Directories="$(PublishDir)scripts" />
  </Target>
  <ItemGroup>
    <Content Include="scripts\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
      <Link>scripts\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>
</Project>


