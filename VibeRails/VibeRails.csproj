<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <AssemblyName>vb</AssemblyName>
    <RootNamespace>VibeRails</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <Version>10.13.26</Version>
    <FileVersion>10.13.26.0</FileVersion>
    <InformationalVersion>10.13.26</InformationalVersion>
    <NoWarn>$(NoWarn);IL2104;IL2026;IL2057;IL2070;IL2075;IL2080;IL3050</NoWarn>
    <!-- sqlite-vec native binaries exist for all our target RIDs (including arm64) but its
         .targets file only allows x64/x86 PlatformTarget. Disable the check. -->
    <EnableUnsupportedPlatformTargetCheck>false</EnableUnsupportedPlatformTargetCheck>
  </PropertyGroup>
  <!-- Apple's new linker crashes on large NativeAOT objects (largeAddends assertion).
       Keep the workaround scoped to our macOS native target; Windows/Linux are unchanged.
       https://github.com/dotnet/runtime/issues/119380 -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' and '$(PublishAot)' == 'true'">
    <LinkerArg Include="-Wl,-ld_classic" />
  </ItemGroup>
  <ItemGroup>
    <!-- Already on the graph transitively via PyBridge (which is IsAotCompatible/IsTrimmable);
         referenced directly here because Services/Cli/CliWrapper.cs uses it as a first-party
         dependency rather than through PyBridge's Python-specific surface. -->
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
    <PackageReference Include="TimeZoneConverter" Version="8.0.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
  </ItemGroup>
  <!-- The modern Windows console host (VIBE-354): conpty.dll and the OpenConsole.exe it starts,
       copied side by side into conpty\ for Services/Terminal/Pty/BundledConsoleHost.cs. It is used
       only when Settings > Modern Windows console host is on; Pty.Net loads the DLL by absolute path.
       Only the package's files are taken (ExcludeAssets): its own targets put OpenConsole.exe in an
       x64\ subfolder and only when PlatformTarget names an architecture, which an AnyCPU build never
       does, and a conpty.dll that cannot find OpenConsole.exe silently starts conhost.exe instead.
       x64 only: there is no win-arm64 build of VibeRails. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.25.261109001" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(PkgMicrosoft_Windows_Console_ConPTY)' != '' and ('$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))))">
    <Content Include="$(PkgMicrosoft_Windows_Console_ConPTY)\runtimes\win-x64\native\conpty.dll" Link="conpty\conpty.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <Content Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\x64\OpenConsole.exe" Link="conpty\OpenConsole.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VibeRails.Data.Sqlite\VibeRails.Data.Sqlite.csproj" />
    <ProjectReference Include="..\VibeRails.Data.Abstractions\VibeRails.Data.Abstractions.csproj" />
    <ProjectReference Include="..\MintLint\MintLint.csproj" />
    <ProjectReference Include="..\PyBridge\src\PyBridge\PyBridge.csproj" />
    <ProjectReference Include="..\Pty.Net\Pty.Net.csproj" />
    <ProjectReference Include="..\TerminalEmulator\TerminalEmulator.csproj" />
    <ProjectReference Include="..\TokenSaver\TokenSaver.csproj" />
  </ItemGroup>
  <!-- Copy wwwroot to output directory -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot/js/modules/codex-model-capabilities.json" LogicalName="CodexModelCapabilities.json" />
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot\assets\" />
  </ItemGroup>
  <!-- Copy bundled BERT embedder (Models/BertV2) and search re-ranker (Models/Reranker) assets to output directory -->
  <ItemGroup>
    <Content Include="Models\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
      <Link>Models\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <!-- Copy root download scripts to output directory for post-deploy setup -->
  <ItemGroup>
    <Content Include="..\Scripts\download-bert-model.ps1" Link="Scripts\download-bert-model.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Scripts\download-bert-model.sh" Link="Scripts\download-bert-model.sh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Scripts\download-reranker-model.ps1" Link="Scripts\download-reranker-model.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Scripts\download-reranker-model.sh" Link="Scripts\download-reranker-model.sh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Copy hook scripts to output directory -->
  <!-- Create the scripts subdirectory explicitly to avoid a race condition under NativeAOT
       publish where the RID-specific bin layout doesn't pre-create content subdirectories. -->
  <Target Name="EnsureScriptsDirExists" BeforeTargets="CopyFilesToOutputDirectory;_CopyOutOfDateSourceItemsToOutputDirectory">
    <MakeDir Directories="$(OutDir)scripts" />
  </Target>
  <Target Name="EnsureScriptsDirExistsForPublish" BeforeTargets="CopyFilesToPublishDirectory;_CopyResolvedFilesToPublishAlways;_CopyResolvedFilesToPublishPreserveNewest">
    <MakeDir Directories="$(PublishDir)scripts" />
  </Target>
  <ItemGroup>
    <Content Include="scripts\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
      <Link>scripts\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>
</Project>


