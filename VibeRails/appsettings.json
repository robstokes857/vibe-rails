{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "None",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VibeRails": {
    "Version": "1.4.5",
    "InstallDirName": ".vibe_rails",
    "ExecutableName": "vb",
    "FrontendUrl": "https://viberails.ai",
    "Hooks": {
      "AutoInstall": false,
      "InstallOnStartup": false
    },
    "BertCapture": {
      "Enabled": true,
      "ModelDirectory": "",
      "DataDirectory": "",
      "MaxDiffCharsPerFile": 2000
    }
  }
}
