{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "None",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VibeRails": {
    "Version": "10.12.8",
    "InstallDirName": ".vibe_rails",
    "ExecutableName": "vb",
    "FrontendUrl": "https://viberails.ai",
    "Hooks": {
      "AutoInstall": true,
      "InstallOnStartup": true
    },
    "TokenSavingsPublish": {
      "Enabled": true,
      "EndpointUrl": "https://viberails.ai/api/v2/token-savings",
      "IntervalMinutes": 15
    }
  }
}
