{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "copy-backend",
      "type": "shell",
      "command": "robocopy \"${workspaceFolder}\\VibeRails\\bin\\Debug\\net10.0\" \"${workspaceFolder}\\vscode-viberails\\bin\\win32-x64\" /MIR /NFL /NDL /NJH /NJS; if ($LASTEXITCODE -le 7) { exit 0 } else { exit 1 }",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "compile-extension",
      "type": "npm",
      "script": "compile",
      "path": "vscode-viberails",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "build-all",
      "dependsOn": ["copy-backend", "compile-extension"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
