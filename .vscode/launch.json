{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension + Backend",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-viberails"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-viberails/out/**/*.js"
      ],
      "preLaunchTask": "build-all"
    }
  ]
}
