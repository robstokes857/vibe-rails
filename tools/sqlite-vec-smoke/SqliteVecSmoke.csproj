    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>sqlite-vec-smoke</AssemblyName>
    <EnableUnsupportedPlatformTargetCheck>false</EnableUnsupportedPlatformTargetCheck>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../VibeRails.Data.Sqlite/VibeRails.Data.Sqlite.csproj" />
  </ItemGroup>
</Project>
