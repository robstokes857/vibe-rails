{
  "name": "vscode-viberails",
  "displayName": "VibeRails",
  "description": "A developer and enterprise friendly framework that keeps vibe coding from going off the rails: deterministic rules, full session audit and replay, token savings, and Claude Code and Codex side by side.",
  "version": "10.13.1",
  "publisher": "viberails",
  "icon": "media/vs-logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robstokes857/vibe-rails.git",
    "directory": "vscode-viberails"
  },
  "bugs": {
    "url": "https://github.com/robstokes857/vibe-rails/issues"
  },
  "engines": {
    "node": ">=24",
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "llm",
    "claude",
    "codex",
    "copilot",
    "agents",
    "terminal"
  ],
  "preview": false,
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "VibeRails launches a bundled local backend that runs git and AI CLI processes inside your workspace folder, which is unsafe in untrusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "VibeRails needs a real file system and the ability to spawn local processes."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "viberails.open",
        "title": "VibeRails: Open Dashboard",
        "icon": {
          "light": "media/vs-logo.png",
          "dark": "media/vs-logo.png"
        }
      },
      {
        "command": "viberails.stop",
        "title": "VibeRails: Stop"
      },
      {
        "command": "viberails.addScript",
        "title": "Add to VibeRails Scripts…",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "viberails.launcher.run",
        "title": "Run now",
        "category": "VibeRails",
        "icon": "$(play)"
      },
      {
        "command": "viberails.launcher.refresh",
        "title": "Refresh Launcher",
        "category": "VibeRails",
        "icon": "$(refresh)"
      },
      {
        "command": "viberails.launcher.customize",
        "title": "Customize Launcher List…",
        "category": "VibeRails",
        "icon": "$(settings-gear)"
      },
      {
        "command": "viberails.launcher.manage",
        "title": "Manage Automations",
        "category": "VibeRails",
        "icon": "$(list-unordered)"
      },
      {
        "command": "viberails.reviewInbox.refresh",
        "title": "Refresh Reviews Requested of You",
        "category": "VibeRails",
        "icon": "$(refresh)"
      },
      {
        "command": "viberails.reviewInbox.open",
        "title": "Open Reviews Requested of You",
        "category": "VibeRails"
      },
      {
        "command": "viberails.reviewInbox.read",
        "title": "Read on viberails.ai",
        "category": "VibeRails",
        "icon": "$(globe)"
      },
      {
        "command": "viberails.reviewInbox.approve",
        "title": "Approve…",
        "category": "VibeRails",
        "icon": "$(check)"
      },
      {
        "command": "viberails.reviewInbox.reject",
        "title": "Reject…",
        "category": "VibeRails",
        "icon": "$(close)"
      },
      {
        "command": "viberails.reviewRequests.refresh",
        "title": "Refresh Review Requests",
        "category": "VibeRails",
        "icon": "$(refresh)"
      },
      {
        "command": "viberails.reviewRequests.open",
        "title": "Open Review Request on the Board",
        "category": "VibeRails"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "viberails",
          "title": "VibeRails",
          "icon": "$(play)"
        }
      ]
    },
    "views": {
      "viberails": [
        {
          "id": "viberails.launcher",
          "name": "Launch",
          "contextualTitle": "VibeRails"
        },
        {
          "id": "viberails.reviewInbox",
          "name": "Reviews requested of you",
          "contextualTitle": "VibeRails"
        },
        {
          "id": "viberails.reviewRequests",
          "name": "Review requests",
          "contextualTitle": "VibeRails"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "viberails.launcher",
        "when": "!viberails.backendReady",
        "contents": "Start VibeRails to list your automations and scripts.\n[Open Dashboard](command:viberails.open)"
      },
      {
        "view": "viberails.reviewInbox",
        "when": "!viberails.backendReady",
        "contents": "Start VibeRails to see the changes other people asked you to review.\n[Open Dashboard](command:viberails.open)"
      },
      {
        "view": "viberails.reviewRequests",
        "when": "!viberails.backendReady",
        "contents": "Start VibeRails to see this project's review requests and their decisions.\n[Open Dashboard](command:viberails.open)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "viberails.reviewInbox.refresh",
          "when": "view == viberails.reviewInbox",
          "group": "navigation@1"
        },
        {
          "command": "viberails.reviewRequests.refresh",
          "when": "view == viberails.reviewRequests",
          "group": "navigation@1"
        },
        {
          "command": "viberails.launcher.refresh",
          "when": "view == viberails.launcher",
          "group": "navigation@1"
        },
        {
          "command": "viberails.launcher.customize",
          "when": "view == viberails.launcher",
          "group": "navigation@2"
        },
        {
          "command": "viberails.launcher.manage",
          "when": "view == viberails.launcher",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "viberails.launcher.run",
          "when": "view == viberails.launcher && viewItem == launcherItem",
          "group": "inline"
        },
        {
          "command": "viberails.reviewInbox.approve",
          "when": "view == viberails.reviewInbox && viewItem == reviewInboxOpenItem",
          "group": "inline@1"
        },
        {
          "command": "viberails.reviewInbox.reject",
          "when": "view == viberails.reviewInbox && viewItem == reviewInboxOpenItem",
          "group": "inline@2"
        },
        {
          "command": "viberails.reviewInbox.read",
          "when": "view == viberails.reviewInbox && viewItem =~ /^reviewInbox/",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "viberails.launcher.run",
          "when": "false"
        },
        {
          "command": "viberails.reviewInbox.open",
          "when": "false"
        },
        {
          "command": "viberails.reviewInbox.read",
          "when": "false"
        },
        {
          "command": "viberails.reviewInbox.approve",
          "when": "false"
        },
        {
          "command": "viberails.reviewInbox.reject",
          "when": "false"
        },
        {
          "command": "viberails.reviewRequests.open",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "viberails.addScript",
          "group": "navigation@100",
          "when": "!explorerResourceIsFolder && resourceScheme == file && resourceExtname =~ /\\.(ps1|sh|py)$/i"
        }
      ],
      "editor/title/context": [
        {
          "command": "viberails.addScript",
          "group": "navigation@100",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(ps1|sh|py)$/i"
        }
      ],
      "editor/title": [
        {
          "command": "viberails.open",
          "group": "navigation",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "VibeRails",
      "properties": {
        "viberails.autoStart": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Start VibeRails in the background when a trusted workspace opens, so the sidebar is ready and the dashboard opens faster. Closing the dashboard tab keeps VibeRails and scheduled automations running until you stop VibeRails or close this VS Code window. Disable this to start only when you open the dashboard."
        },
        "viberails.startupTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "maximum": 600000,
          "markdownDescription": "How long to wait for the VibeRails backend to start before giving up. Raise this if a cold first launch on a slow machine times out."
        }
      }
    },
    "keybindings": [
      {
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "command": "viberails.open"
      },
      {
        "key": "escape",
        "command": "-editor.action.webvieweditor.escape",
        "when": "activeWebviewPanelId == 'viberailsDashboard'"
      },
      {
        "key": "shift+enter",
        "command": "-workbench.action.chatSubmit",
        "when": "activeWebviewPanelId == 'viberailsDashboard'"
      },
      {
        "key": "shift+enter",
        "command": "-editor.action.insertLineBefore",
        "when": "activeWebviewPanelId == 'viberailsDashboard'"
      },
      {
        "key": "shift+enter",
        "command": "",
        "when": "activeWebviewPanelId == 'viberailsDashboard'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js",
    "smoke": "node ./out/test/runTest.js",
    "pretest": "npm run compile",
    "prepare-binaries": "pwsh -ExecutionPolicy Bypass -File ../deploy/prepare-binaries.ps1",
    "package": "npm run package:all",
    "package:all": "pwsh -ExecutionPolicy Bypass -File ../deploy/package-platforms.ps1",
    "package:win32-x64": "pwsh -ExecutionPolicy Bypass -File ../deploy/package-platforms.ps1 -Targets win32-x64",
    "package:linux-x64": "pwsh -ExecutionPolicy Bypass -File ../deploy/package-platforms.ps1 -Targets linux-x64",
    "package:darwin-arm64": "pwsh -ExecutionPolicy Bypass -File ../deploy/package-platforms.ps1 -Targets darwin-arm64",
    "release": "pwsh -ExecutionPolicy Bypass -File ../deploy/buildAndDeployVSCodeExt.ps1",
    "marketplace:test": "pwsh -ExecutionPolicy Bypass -File ../deploy/test-vscode-marketplace.ps1",
    "marketplace:publish-only": "pwsh -ExecutionPolicy Bypass -File ../deploy/test-vscode-marketplace.ps1 -Publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "3.9.2",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.0"
  }
}
