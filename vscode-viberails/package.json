{
  "name": "vscode-viberails",
  "displayName": "VibeRails",
  "description": "Launch and control VibeRails dashboard inside VS Code",
  "version": "1.9.20",
  "publisher": "viberails",
  "icon": "media/vs-logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robstokes857/vibe-rails.git",
    "directory": "vscode-viberails"
  },
  "bugs": {
    "url": "https://github.com/robstokes857/vibe-rails/issues"
  },
  "engines": {
    "node": ">=24",
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "llm",
    "claude",
    "codex",
    "copilot",
    "agents",
    "terminal"
  ],
  "preview": false,
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "VibeRails launches a bundled local backend that runs git and AI CLI processes inside your workspace folder, which is unsafe in untrusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "VibeRails needs a real file system and the ability to spawn local processes."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "viberails.open",
        "title": "VibeRails: Open Dashboard",
        "icon": {
          "light": "media/vs-logo.png",
          "dark": "media/vs-logo.png"
        }
      },
      {
        "command": "viberails.stop",
        "title": "VibeRails: Stop Dashboard"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "viberails.open",
          "group": "navigation",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "VibeRails",
      "properties": {
        "viberails.startupTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "maximum": 600000,
          "markdownDescription": "How long to wait for the VibeRails backend to start before giving up. Raise this if a cold first launch on a slow machine times out."
        }
      }
    },
    "keybindings": [
      {
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "command": "viberails.open"
      },
      {
        "key": "escape",
        "command": "-editor.action.webvieweditor.escape",
        "when": "activeWebviewPanelId == 'viberailsDashboard'"
      },
      {
        "key": "shift+enter",
        "command": "-workbench.action.chatSubmit",
        "when": "activeWebviewPanelId == 'viberailsDashboard'"
      },
      {
        "key": "shift+enter",
        "command": "-editor.action.insertLineBefore",
        "when": "activeWebviewPanelId == 'viberailsDashboard'"
      },
      {
        "key": "shift+enter",
        "command": "",
        "when": "activeWebviewPanelId == 'viberailsDashboard'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js",
    "smoke": "node ./out/test/runTest.js",
    "pretest": "npm run compile",
    "prepare-binaries": "pwsh -ExecutionPolicy Bypass -File ../deploy/prepare-binaries.ps1",
    "package": "npm run package:all",
    "package:all": "pwsh -ExecutionPolicy Bypass -File ../deploy/package-platforms.ps1",
    "package:win32-x64": "pwsh -ExecutionPolicy Bypass -File ../deploy/package-platforms.ps1 -Targets win32-x64",
    "package:linux-x64": "pwsh -ExecutionPolicy Bypass -File ../deploy/package-platforms.ps1 -Targets linux-x64",
    "package:darwin-x64": "pwsh -ExecutionPolicy Bypass -File ../deploy/package-platforms.ps1 -Targets darwin-x64",
    "package:darwin-arm64": "pwsh -ExecutionPolicy Bypass -File ../deploy/package-platforms.ps1 -Targets darwin-arm64",
    "release": "pwsh -ExecutionPolicy Bypass -File ../deploy/buildAndDeployVSCodeExt.ps1",
    "marketplace:test": "pwsh -ExecutionPolicy Bypass -File ../deploy/test-vscode-marketplace.ps1",
    "marketplace:publish-only": "pwsh -ExecutionPolicy Bypass -File ../deploy/test-vscode-marketplace.ps1 -Publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^11.7.4",
    "typescript": "^7.0.2"
  }
}
