<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <FrontRepoRoot Condition="'$(FrontRepoRoot)' == ''">$(MSBuildThisFileDirectory)../../../../VibeRails-Front</FrontRepoRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../../VibeRails/VibeRails.csproj" />
    <ProjectReference Include="$(FrontRepoRoot)/VibeRails-Front/VibeRails-Front.csproj" />
  </ItemGroup>
</Project>
