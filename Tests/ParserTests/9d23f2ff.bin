     [1m[4m[3mResumed Session: Start in Thinking State[22m[24m[23m[K[127C
[172C
     [1mContext[22m[K[160C
[172C
     When a user resumes a session (chat history → send to → CLI), the terminal tab currently starts in "Connected" state like a normal session. This is wrong —[12C
      the resumed session immediately begins working (injecting the summary prompt into the LLM), so the tab should show "Thinking" from the start. Normal[18C
     (non-resumed) sessions are unaffected.[129C
[172C
     [1mChanges[22m [1m(2[22m [1mfiles,[22m [1m~8[22m [1mlines)[22m[K[140C
[172C
     [1m1.[22m [38;2;177;185;249m[1mVibeRails/wwwroot/js/modules/terminal-tab-status.js[m[K[113C
[172C
     [1mA.[22m [1mConstructor[22m [1m(line[22m [1m64[22m [1marea)[22m — add field:[K[125C
     [36mthis[m._startAsThinking = [34mfalse[m;[K[137C
[172C
     [1mB.[22m [1mNew[22m [1mmethod[22m [1m(after[22m [38;2;177;185;249m[1monSocketOpen[m[1m,[22m [1m~line[22m [1m147)[22m:[K[121C
     [33mmarkResumedSession() [m{[K[145C
[36m[9Cthis[m._startAsThinking = [34mtrue[m;[K[134C
     }[166C
[172C
     [1mC.[22m [1mModify[22m [38;2;177;185;249m[1monSocketOpen() [m[1m(lines[22m [1m145-147)[22m — skip CONNECTED for resumed sessions:[K[88C
     [33monSocketOpen() [m{[K[151C
[34m[9Cif [m([36mthis[m._startAsThinking) {[K[135C
[36m[13Cthis[m._startAsThinking = [34mfalse[m;[K[129C
[36m[13Cthis[m._transitionTo(TAB_STATUS.THINKING);[K[119C
         } [34melse [m{[K[155C
[36m[13Cthis[m._transitionTo(TAB_STATUS.CONNECTED);[K[118C
         }[162C
     }[166C
[172C
     [1m2.[22m [38;2;177;185;249m[1mVibeRails/wwwroot/js/modules/terminal-multitab.js[m[K[115C
[172C
     [1mIn[22m [38;2;177;185;249m[1mstartSession(body) [m[1m(~line[22m [1m626,[22m [1mbefore[22m [38;2;177;185;249m[1mawait[m [38;2;177;185;249m[1mthis.connect()[m[1m):[22m[K[104C
     [34mif [m(body.resumeSessionId) {[K[140C
[36m[9Cthis[m.statusController?.markResumedSession();[K[119C
     }[166C
