<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- xunit.v3 4.x defaults to Microsoft Testing Platform v2, whose MSBuild targets refuse the
         classic VSTest-mode `dotnet test` on the .NET 10 SDK (this killed release v10.11.18).
         The mtp-off variant is the same xunit with MTP support disabled, so `dotnet test`,
         filter switches and the release workflow keep working unchanged. Moving to the MTP-mode
         `dotnet test` needs a global.json test.runner opt-in and a different command-line
         surface; do that as its own change, not as part of a package bump. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MintLint\MintLint.csproj" />
    <ProjectReference Include="..\TokenSaver\TokenSaver.csproj" />
    <ProjectReference Include="..\VibeRails\VibeRails.csproj" />
  </ItemGroup>

  <!-- Needed to host the in-process MCP server (Kestrel + MapMcp) inside the
       MCP HTTP-handshake integration test. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="test_agent.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Services\Terminal\Fixtures\*.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Services\BertV2\Fixtures\*.jsonl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="headless\**\*.cs" />
    <None Remove="headless\**\*" />
    <EmbeddedResource Remove="headless\**\*" />
    <Content Remove="headless\**\*" />
  </ItemGroup>

  <!-- VCA regression fixtures are sample repositories, not test sources: the .cs files inside
       them are staged-content fixtures and must never be compiled into this assembly. The
       tests read them from the source tree by path (see VcaRegressionRepository). -->
  <ItemGroup>
    <Compile Remove="VcaRegression\Fixtures\**" />
    <None Remove="VcaRegression\Fixtures\**" />
    <EmbeddedResource Remove="VcaRegression\Fixtures\**" />
    <Content Remove="VcaRegression\Fixtures\**" />
  </ItemGroup>

</Project>
