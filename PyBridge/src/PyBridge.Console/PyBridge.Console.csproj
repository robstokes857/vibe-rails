<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PyBridge.Console</RootNamespace>

    <!-- NativeAOT publish settings. `dotnet run` still works as a normal JIT build; a full
         native binary requires the MSVC C++ toolchain (Visual Studio "Desktop development
         with C++"). Producing it is `dotnet publish -c Release`. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Run the trim/AOT analyzers during a normal build too, so AOT problems surface early. -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PyBridge\PyBridge.csproj" />
  </ItemGroup>

</Project>
